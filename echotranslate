    return True

def record_voice():
    """Record a new voice profile."""
    clear_screen()
    show_banner()
    
    console.print(Panel.fit("Record Voice Profile", style="bold yellow"))
    
    name = Prompt.ask("\nEnter a name for this voice profile")
    
    console.print("\n[yellow]Recording Instructions:[/yellow]")
    console.print("- Press Enter to START recording")
    console.print("- Press Enter again to STOP recording")
    console.print("- Aim for 5+ minutes of natural speech")
    console.print("- Consider having a phone conversation (with headphones)")
    
    input("\n[cyan]Press Enter when ready to start recording...[/cyan]")
    
    # Start recording with a large buffer
    console.print("\n[bold red]RECORDING - Press Enter to stop[/bold red]")
    console.print("[dim]Speak naturally, as if in conversation...[/dim]\n")
    
    # Use a threading approach for cross-platform compatibility
    import threading
    import queue
    
    audio_queue = queue.Queue()
    stop_recording = threading.Event()
    
    def audio_callback(indata, frames, time_info, status):
        if status:
            print(f"\nAudio error: {status}")
        audio_queue.put(indata.copy())
    
    # Start recording
    stream = sd.InputStream(
        samplerate=22050, 
        channels=1, 
        dtype='float32',
        callback=audio_callback
    )
    
    # Thread to display elapsed time
    def show_time():
        start_time = time.time()
        while not stop_recording.is_set():
            elapsed = time.time() - start_time
            mins, secs = divmod(int(elapsed), 60)
            print(f"\r[red]Recording: {mins:02d}:{secs:02d}[/red] - Press Enter to stop", end="", flush=True)
            time.sleep(0.1)
    
    time_thread = threading.Thread(target=show_time)
    
    with stream:
        stream.start()
        time_thread.start()
        
        # Wait for Enter key
        input()
        
        # Stop recording
        stop_recording.set()
        stream.stop()
    
    time_thread.join()
    
    # Collect all audio chunks
    chunks = []
    while not audio_queue.empty():
        chunks.append(audio_queue.get())
    
    if chunks:
        import numpy as np
        recording = np.concatenate(chunks, axis=0)
        
        duration = len(recording) / 22050
        mins, secs = divmod(int(duration), 60)
        console.print(f"\n\n[green]Recording complete! Duration: {mins:02d}:{secs:02d}[/green]")
        
        if duration < 60:
            console.print("[yellow]Warning: Recording is less than 1 minute. Longer recordings produce better results.[/yellow]")
        
        # Save voice
        voice_file = VOICES_DIR / f"{name}.wav"
        sf.write(voice_file, recording, 22050)
        
        console.print(f"[green]Voice profile saved as: {name}[/green]")
    else:
        console.print("[red]No audio recorded. Please try again.[/red]")
    
    input("\nPress Enter to continue...")

def translate_text():
    """Practice text with voice synthesis."""
    clear_screen()
    show_banner()
    
    console.print(Panel.fit("Practice with Text Translation", style="bold green"))
    
    # Select voice
    voices = get_voices()
    if not voices:
        console.print("[red]No voices found! Please record a voice first.[/red]")
        input("\nPress Enter to continue...")
        return
    
    console.print("\n[cyan]Available voice profiles:[/cyan]")
    for i, voice in enumerate(voices, 1):
        console.print(f"  {i}. {voice}")
    
    voice_idx = IntPrompt.ask("\nSelect voice profile", choices=[str(i) for i in range(1, len(voices)+1)])
    selected_voice = voices[int(voice_idx)-1]
    
    # Select language
    console.print("\n[cyan]Target languages:[/cyan]")
    table = Table(show_header=True, header_style="bold cyan")
    table.add_column("#", width=3)
    table.add_column("Language", width=20)
    table.add_column("Region", width=20)
    
    for num, lang in LANGUAGES.items():
        table.add_row(num, lang["name"], lang["region"])
    
    console.print(table)
    
    lang_choice = Prompt.ask("\nSelect language", choices=[str(i) for i in range(1, len(LANGUAGES)+1)])
    target_lang = LANGUAGES[lang_choice]["code"]
    target_name = LANGUAGES[lang_choice]["name"]
    
    # Get text
    text = Prompt.ask("\n[yellow]Enter text to practice[/yellow]")
    
    # Initialize model if needed
    if not init_model():
        input("\nPress Enter to continue...")
        return
    
    # Translate
    if target_lang == "en":
        translated = text  # No translation needed for English
        console.print(f"\n[cyan]Using English text directly...[/cyan]")
    else:
        console.print(f"\n[cyan]Translating to {target_name}...[/cyan]")
        translated = argostranslate.translate.translate(text, "en", target_lang.split("-")[0])
        console.print(f"[green]Translation:[/green] {translated}")
    
    # Generate with voice
    console.print(f"\n[yellow]Generating audio with {selected_voice}'s voice...[/yellow]")
    
    voice_file = VOICES_DIR / f"{selected_voice}.wav"
    
    # Create date-based subdirectory
    date_dir = OUTPUT_DIR / datetime.now().strftime("%Y-%m-%d")
    date_dir.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().strftime("%H%M%S")
    output_file = date_dir / f"{timestamp}_{selected_voice}_{target_lang}.wav"
    
    try:
        # Map language codes for XTTS
        xtts_lang_map = {
            "zh-tw": "zh-cn",
            "ar": "ar",
            "es": "es", 
            "fr": "fr",
            "de": "de",
            "it": "it",
            "pt": "pt",
            "ru": "ru",
            "ja": "ja",
            "ko": "ko"
        }
        
        xtts_lang = xtts_lang_map.get(target_lang, "en")
        
        xtts_model.tts_to_file(
            text=translated,
            speaker_wav=str(voice_file),
            language=xtts_lang,
            file_path=str(output_file)
        )
        
        console.print(f"\n[green]Audio generated successfully![/green]")
        console.print(f"[dim]Saved to: {output_file}[/dim]")
        
        # Play audio
        play = Prompt.ask("\nPlay audio?", choices=["y", "n"], default="y")
        if play == "y":
            data, fs = sf.read(output_file)
            sd.play(data, fs)
            sd.wait()
            
    except Exception as e:
        console.print(f"[red]Error: {e}[/red]")
    
    input("\nPress Enter to continue...")

def live_translation():
    """Live translation practice mode."""
    clear_screen()
    show_banner()
    
    console.print(Panel.fit("Live Translation Practice", style="bold magenta"))
    
    # Check for Whisper
    try:
        import whisper
        import numpy as np
        import queue
        import threading
    except ImportError:
        console.print("\n[red]Whisper not installed![/red]")
        console.print("Please install with: pip install openai-whisper")
        input("\nPress Enter to continue...")
        return
    
    # Select voice
    voices = get_voices()
    if not voices:
        console.print("\n[red]No voices found! Please record a voice first.[/red]")
        input("\nPress Enter to continue...")
        return
    
    console.print("\n[cyan]Select your voice profile:[/cyan]")
    for i, voice in enumerate(voices, 1):
        console.print(f"  {i}. {voice}")
    
    voice_idx = IntPrompt.ask("\nSelect voice profile", choices=[str(i) for i in range(1, len(voices)+1)])
    selected_voice = voices[int(voice_idx)-1]
    
    # Select language
    console.print("\n[cyan]Select target language:[/cyan]")
    for num, lang in LANGUAGES.items():
        console.print(f"  {num}. {lang['name']} ({lang['region']})")
    
    lang_choice = Prompt.ask("\nSelect language", choices=[str(i) for i in range(1, len(LANGUAGES)+1)])
    target_lang = LANGUAGES[lang_choice]["code"]
    target_name = LANGUAGES[lang_choice]["name"]
    
    # Initialize models
    if not init_model():
        input("\nPress Enter to continue...")
        return
    
    console.print(f"\n[yellow]Loading speech recognition model...[/yellow]")
    try:
        # Suppress Whisper loading messages
        import io
        from contextlib import redirect_stdout, redirect_stderr
        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
            whisper_model = whisper.load_model("small", download_root=str(Path.home() / ".cache" / "whisper"))
        console.print("[green]Speech recognition ready[/green]")
    except Exception as e:
        console.print(f"[red]Error loading Whisper: {e}[/red]")
        console.print("[yellow]Whisper model not found. Please run:[/yellow]")
        console.print("  python download_whisper.py")
        console.print("[yellow]while connected to internet[/yellow]")
        input("\nPress Enter to continue...")
        return
    
    console.print(f"\n[green]Ready for live translation[/green]")
    console.print(f"Voice Profile: {selected_voice}")
    console.print(f"Target Language: {target_name}")
    console.print("\n[yellow]Instructions:[/yellow]")
    console.print("- Speak clearly in any language")
    console.print("- Hear the translation in your voice")
    console.print("- Press Ctrl+C to exit\n")
    
    # Audio recording parameters
    RATE = 16000
    CHUNK = int(RATE * 0.1)  # 100ms chunks
    SILENCE_THRESHOLD = 1.5  # seconds of silence to stop recording
    
    audio_queue = queue.Queue()
    
    def audio_callback(indata, frames, time_info, status):
        if status:
            console.print(f"[red]Audio error: {status}[/red]")
        audio_queue.put(indata.copy())
    
    try:
        stream = sd.InputStream(
            channels=1,
            samplerate=RATE,
            callback=audio_callback,
            blocksize=CHUNK
        )
    except Exception as e:
        console.print(f"[red]Error initializing audio: {e}[/red]")
        input("\nPress Enter to continue...")
        return
    
    with stream:
        while True:
            try:
                audio_buffer = []
                silence_counter = 0
                recording = False
                
                console.print("\n[cyan]Listening...[/cyan]")
                
                while True:
                    try:
                        chunk = audio_queue.get(timeout=0.1)
                        volume = np.sqrt(np.mean(chunk**2))
                        
                        if volume > 0.01:
                            if not recording:
                                recording = True
                                console.print("[yellow]Recording...[/yellow]")
                            silence_counter = 0
                            audio_buffer.append(chunk)
                        elif recording:
                            silence_counter += 0.1
                            audio_buffer.append(chunk)
                            
                            if silence_counter >= SILENCE_THRESHOLD:
                                break
                    except queue.Empty:
                        if recording and silence_counter >= SILENCE_THRESHOLD:
                            break
                        continue
                
                if audio_buffer:
                    console.print("[dim]Processing...[/dim]")
                    
                    audio_data = np.concatenate(audio_buffer, axis=0).flatten()
                    
                    try:
                        result = whisper_model.transcribe(
                            audio_data,
                            language=None,
                            fp16=False
                        )
                        
                        text = result["text"].strip()
                        detected_lang = result.get("language", "en")
                        
                        if text:
                            console.print(f"[green]Detected ({detected_lang}):[/green] {text}")
                            
                            if target_lang == "en" and detected_lang != "en":
                                translated = argostranslate.translate.translate(text, detected_lang, "en")
                                console.print(f"[blue]English:[/blue] {translated}")
                            elif target_lang == "en":
                                translated = text  # Already in English
                            else:
                                if detected_lang != "en":
                                    english_text = argostranslate.translate.translate(text, detected_lang, "en")
                                else:
                                    english_text = text
                                
                                translated = argostranslate.translate.translate(english_text, "en", target_lang.split("-")[0])
                                console.print(f"[blue]Translation:[/blue] {translated}")
                            
                            voice_file = VOICES_DIR / f"{selected_voice}.wav"
                            temp_file = Path(tempfile.gettempdir()) / "echotranslate_live.wav"
                            
                            xtts_lang_map = {
                                "zh-tw": "zh-cn",
                                "ar": "ar", "es": "es", "fr": "fr",
                                "de": "de", "it": "it", "pt": "pt",
                                "ru": "ru", "ja": "ja", "ko": "ko"
                            }
                            
                            xtts_lang = xtts_lang_map.get(target_lang, "en")
                            
                            xtts_model.tts_to_file(
                                text=translated,
                                speaker_wav=str(voice_file),
                                language=xtts_lang,
                                file_path=str(temp_file)
                            )
                            
                            try:
                                data, fs = sf.read(temp_file)
                                sd.play(data * 0.8, fs)
                                sd.wait()
                            except Exception as e:
                                console.print(f"[red]Error playing audio: {e}[/red]")
                    
                    except Exception as e:
                        console.print(f"[red]Error: {e}[/red]")
                    
                    while not audio_queue.empty():
                        try:
                            audio_queue.get_nowait()
                        except queue.Empty:
                            break
                            
            except KeyboardInterrupt:
                console.print("\n\n[yellow]Exiting live mode...[/yellow]")
                break
    
    input("\nPress Enter to continue...")

def list_translations():
    clear_screen()
    show_banner()
    
    console.print(Panel.fit("Saved Practice Sessions", style="bold blue"))
    
    try:
        files = list(OUTPUT_DIR.rglob("*.wav"))
    except Exception as e:
        console.print(f"[red]Error reading files: {e}[/red]")
        input("\nPress Enter to continue...")
        return
    if not files:
        console.print("\n[yellow]No practice sessions saved yet[/yellow]")
    else:
        files.sort(key=lambda x: x.stat().st_mtime, reverse=True)
        
        table = Table(show_header=True, header_style="bold cyan")
        table.add_column("#", width=3)
        table.add_column("File", width=40)
        table.add_column("Size", width=10)
        table.add_column("Date", width=20)
        
        for i, file in enumerate(files[:20], 1):
            size = f"{file.stat().st_size / 1024:.1f} KB"
            date = datetime.fromtimestamp(file.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
            table.add_row(str(i), file.name, size, date)
        
        console.print(table)
        
        if files:
            play = Prompt.ask("\n[cyan]Play a file? (enter number or 'n')[/cyan]", default="n")
            if play != "n" and play.isdigit():
                idx = int(play) - 1
                if 0 <= idx < len(files):
                    console.print(f"\n[cyan]Playing: {files[idx].name}[/cyan]")
                    data, fs = sf.read(files[idx])
                    sd.play(data, fs)
                    sd.wait()
    
    input("\nPress Enter to continue...")

