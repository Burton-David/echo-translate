def init_model():
    global xtts_model
    if not xtts_model:
        console.print("\n[yellow]Loading voice synthesis model...[/yellow]")
        
        model_path = Path.home() / ".local/share/tts/tts_models--multilingual--multi-dataset--xtts_v2"
        macos_path = Path.home() / "Library/Application Support/tts/tts_models--multilingual--multi-dataset--xtts_v2"
        
        if not model_path.exists() and not macos_path.exists():
            console.print("[red]XTTS model not found![/red]")
            console.print("[yellow]The model needs to be downloaded first (1.87 GB)[/yellow]")
            console.print("\nRun this command to download:")
            console.print("  python -c \"from TTS.api import TTS; TTS('tts_models/multilingual/multi-dataset/xtts_v2')\"")
            return False
            
        try:
            # Temporarily suppress output during model loading
            import io
            from contextlib import redirect_stdout, redirect_stderr
            with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
                xtts_model = TTS("tts_models/multilingual/multi-dataset/xtts_v2", gpu=False)
            console.print("[green]Model loaded successfully[/green]\n")
        except Exception as e:
            console.print(f"[red]Error loading model: {e}[/red]")
            console.print("[yellow]Try running the download command above[/yellow]")
