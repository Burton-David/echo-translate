def ensure_dependencies():
    console.print("[dim]Checking translation models...[/dim]")
    try:
        argostranslate.package.update_package_index()
        
        needed = ["es", "zh", "fr", "ar", "de", "it", "pt", "ru", "ja", "ko"]
        installed = {p.to_code for p in argostranslate.package.get_installed_packages()}
        
        for lang in needed:
            if lang not in installed:
                for package in argostranslate.package.get_available_packages():
                    if package.from_code == "en" and package.to_code == lang:
                        console.print(f"[dim]Installing {lang} translation model...[/dim]")
                        argostranslate.package.install_from_path(package.download())
                        break
    except Exception as e:
        console.print(f"[red]Error installing dependencies: {e}[/red]")
        console.print("[yellow]Some translation languages may not be available[/yellow]")

